# ─────────────────────────────────────────────────────────────────────────────
# Streamlit Cloud Secrets Template
# Copy ALL of this into: Streamlit Cloud → App → Settings → Secrets
# DO NOT commit the real secrets.toml to Git.
# ─────────────────────────────────────────────────────────────────────────────

# Firebase Web App credentials
# Get from: Firebase Console → Project Settings → Your Apps → Web App
FIREBASE_API_KEY            = "AIzaSy..."
FIREBASE_AUTH_DOMAIN        = "your-project.firebaseapp.com"
FIREBASE_PROJECT_ID         = "your-project-id"
FIREBASE_STORAGE_BUCKET     = "your-project.appspot.com"
FIREBASE_MESSAGING_SENDER_ID = "123456789"
FIREBASE_APP_ID             = "1:123456789:web:abcdef"

# Firebase Admin SDK (for Firestore prediction history)
# Get from: Firebase Console → Project Settings → Service Accounts → Generate new private key
# Paste the ENTIRE downloaded JSON as a single-line string below
FIREBASE_ADMIN_CREDENTIALS  = '{"type":"service_account","project_id":"your-project-id",...}'
